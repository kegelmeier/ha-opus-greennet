{
  "entity": {
    "binary_sensor": {
      "handle_closed": {
        "default": "mdi:help-circle-outline",
        "state": {
          "off": "mdi:window-open",
          "on": "mdi:window-closed"
        }
      },
      "mechanics_fault": {
        "default": "mdi:cog-outline",
        "state": {
          "on": "mdi:alert-circle"
        }
      },
      "digital_input_0": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:toggle-switch",
          "off": "mdi:toggle-switch-off"
        }
      },
      "digital_input_1": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:toggle-switch",
          "off": "mdi:toggle-switch-off"
        }
      },
      "digital_input_2": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:toggle-switch",
          "off": "mdi:toggle-switch-off"
        }
      },
      "digital_input_3": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:toggle-switch",
          "off": "mdi:toggle-switch-off"
        }
      },
      "wake_signal": {
        "default": "mdi:alarm"
      },
      "occupancy_button": {
        "default": "mdi:gesture-tap-button"
      },
      "energy_input": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:solar-power",
          "off": "mdi:solar-power-variant-outline"
        }
      },
      "energy_storage_charged": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:battery-high",
          "off": "mdi:battery-low"
        }
      },
      "radio_signal_weak": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:wifi-strength-alert-outline",
          "off": "mdi:wifi-strength-4"
        }
      },
      "radio_error": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:access-point-network-off",
          "off": "mdi:access-point-network"
        }
      }
    },
    "sensor": {
      "handle_state": {
        "default": "mdi:help-circle-outline",
        "state": {
          "closed": "mdi:window-closed",
          "open": "mdi:window-open",
          "tilted": "mdi:window-open-variant"
        }
      },
      "unlock_request": {
        "default": "mdi:lock-question",
        "state": {
          "not_requested": "mdi:lock-outline",
          "requested": "mdi:lock-clock"
        }
      },
      "reman_state": {
        "default": "mdi:lan",
        "state": {
          "learned_in": "mdi:lan-connect",
          "query_starting": "mdi:lan-pending",
          "no_response": "mdi:lan-disconnect",
          "not_seen": "mdi:lan-disconnect",
          "wrong_secure_code": "mdi:lock-alert-outline"
        }
      },
      "device_id": {
        "default": "mdi:identifier"
      },
      "signal_quality": {
        "default": "mdi:wifi-strength-off-outline",
        "state": {
          "good": "mdi:wifi-strength-4",
          "sufficient": "mdi:wifi-strength-2",
          "poor": "mdi:wifi-strength-alert-outline"
        }
      },
      "gateway_uptime": {
        "default": "mdi:timer-outline"
      },
      "wall_switch_links": {
        "default": "mdi:link-variant"
      },
      "gateway_eurid": {
        "default": "mdi:identifier"
      },
      "gateway_firmware_version": {
        "default": "mdi:chip"
      },
      "gateway_app_version": {
        "default": "mdi:application-outline"
      },
      "gateway_api_version": {
        "default": "mdi:api"
      },
      "gateway_hostname": {
        "default": "mdi:dns-outline"
      },
      "gateway_ipv4_address": {
        "default": "mdi:ip-network-outline"
      },
      "gateway_ipv6_address": {
        "default": "mdi:ip-network-outline"
      },
      "valve_position": {
        "default": "mdi:valve"
      },
      "setpoint_shift": {
        "default": "mdi:plus-minus-variant"
      },
      "acceleration_x": {
        "default": "mdi:axis-x-arrow"
      },
      "acceleration_y": {
        "default": "mdi:axis-y-arrow"
      },
      "acceleration_z": {
        "default": "mdi:axis-z-arrow"
      },
      "fan_speed": {
        "default": "mdi:fan"
      },
      "actuator_mode": {
        "default": "mdi:cog-outline"
      },
      "setpoint_type": {
        "default": "mdi:swap-vertical"
      },
      "load": {
        "default": "mdi:gauge"
      },
      "channel_count": {
        "default": "mdi:counter"
      },
      "ip_address": {
        "default": "mdi:ip-network-outline"
      },
      "hardware_version": {
        "default": "mdi:chip"
      },
      "software_version": {
        "default": "mdi:application-outline"
      },
      "network_version": {
        "default": "mdi:lan"
      },
      "device_type": {
        "default": "mdi:shape-outline"
      },
      "manufacturer": {
        "default": "mdi:factory"
      },
      "serial": {
        "default": "mdi:identifier"
      },
      "version": {
        "default": "mdi:tag-outline"
      },
      "temperature_setpoint": {
        "default": "mdi:thermostat"
      },
      "acceleration_status": {
        "default": "mdi:vibrate"
      },
      "heater_mode": {
        "default": "mdi:thermostat-box",
        "state": {
          "heating": "mdi:fire",
          "cooling": "mdi:snowflake"
        }
      },
      "system_error": {
        "default": "mdi:alert-circle-outline",
        "state": {
          "no_error": "mdi:check-circle-outline"
        }
      },
      "led_status": {
        "default": "mdi:help-circle-outline",
        "state": {
          "enabled": "mdi:led-on",
          "disabled": "mdi:led-off"
        }
      },
      "gateway_receive_counter": {
        "default": "mdi:counter"
      },
      "channel_circuit_state": {
        "default": "mdi:help-circle-outline",
        "state": {
          "on": "mdi:radiator",
          "off": "mdi:radiator-off"
        }
      },
      "channel_operation_mode": {
        "default": "mdi:cog-outline"
      },
      "channel_temperature_setpoint": {
        "default": "mdi:thermostat"
      }
    },
    "button": {
      "reference_run_up": {
        "default": "mdi:arrow-collapse-up"
      },
      "reference_run_down": {
        "default": "mdi:arrow-collapse-down"
      },
      "read_settings": {
        "default": "mdi:refresh"
      }
    }
  },
  "services": {
    "get_device_configuration": {
      "service": "mdi:file-download-outline"
    },
    "get_device_link_tables": {
      "service": "mdi:link-variant"
    },
    "get_device_parameters": {
      "service": "mdi:tune-variant"
    },
    "reload_entry": {
      "service": "mdi:reload"
    },
    "set_device_configuration": {
      "service": "mdi:file-upload-outline"
    },
    "set_cover_position": {
      "service": "mdi:blinds"
    }
  }
}
